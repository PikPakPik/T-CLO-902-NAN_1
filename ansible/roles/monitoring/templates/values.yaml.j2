---
# Stack monitoring (Grafana, Prometheus, etc.) sur worker1 uniquement
# node-exporter : DaemonSet sur chaque nœud du cluster (y compris master)

# ----- Grafana (exposé via HTTPRoute {{ monitoring_grafana_hostname }}) -----
grafana:
  enabled: true
  admin:
    existingSecret: "{{ grafana_admin_secret_name }}"
    userKey: admin-user
    passwordKey: admin-password
  initChownData:
    enabled: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 472
    runAsGroup: 472
    fsGroup: 472
  grafana.ini:
    server:
      root_url: "http://{{ monitoring_grafana_hostname }}/"
      domain: "{{ monitoring_grafana_hostname }}"
      serve_from_sub_path: false
  service:
    type: ClusterIP
  nodeSelector:
    kubernetes.io/hostname: {{ monitoring_target_node_name }}
  persistence:
    enabled: true
    type: pvc
    storageClassName: {{ monitoring_storage_class }}
    accessModes: ["ReadWriteOnce"]
    size: 5Gi

# ----- Prometheus (exposé via HTTPRoute {{ monitoring_prometheus_hostname }}) -----
prometheus:
  service:
    type: ClusterIP
  prometheusSpec:
    retention: {{ monitoring_prometheus_retention }}
    externalUrl: "http://{{ monitoring_prometheus_hostname }}/"
    routePrefix: /
    nodeSelector:
      kubernetes.io/hostname: {{ monitoring_target_node_name }}
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: {{ monitoring_storage_class }}
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: {{ monitoring_prometheus_pvc_size }}

# ----- Alertmanager -----
alertmanager:
  alertmanagerSpec:
    nodeSelector:
      kubernetes.io/hostname: {{ monitoring_target_node_name }}
    storage:
      volumeClaimTemplate:
        spec:
          storageClassName: {{ monitoring_storage_class }}
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 2Gi

# ----- prometheus-operator -----
prometheusOperator:
  nodeSelector:
    kubernetes.io/hostname: {{ monitoring_target_node_name }}
  admissionWebhooks:
    patch:
      nodeSelector:
        kubernetes.io/hostname: {{ monitoring_target_node_name }}

# ----- kube-state-metrics -----
kube-state-metrics:
  nodeSelector:
    kubernetes.io/hostname: {{ monitoring_target_node_name }}

# ----- node-exporter : un pod par nœud (DaemonSet) -----
prometheus-node-exporter:
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule
    - key: node-role.kubernetes.io/master
      operator: Exists
      effect: NoSchedule
