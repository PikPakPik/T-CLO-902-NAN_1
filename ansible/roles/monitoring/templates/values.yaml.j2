---
# Stack monitoring (Grafana, Prometheus, etc.) sur worker1 uniquement
# node-exporter : DaemonSet sur chaque nœud du cluster (y compris master)

# ----- Grafana (exposé via HTTPRoute {{ monitoring_grafana_hostname }}) -----
grafana:
  enabled: true
  admin:
    existingSecret: "{{ grafana_admin_secret_name }}"
    userKey: admin-user
    passwordKey: admin-password
  initChownData:
    enabled: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 472
    runAsGroup: 472
    fsGroup: 472
  # Secret du client OAuth Dex (clé GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET) — voir
  # infra/monitoring/grafana-oauth-sealedsecret.yaml (procédure : docs/dex.md).
  envFromSecret: "{{ grafana_oauth_secret_name }}"
  grafana.ini:
    server:
      root_url: "http://{{ monitoring_grafana_hostname }}/"
      domain: "{{ monitoring_grafana_hostname }}"
      serve_from_sub_path: false
    # ----- SSO via Dex (comptes locaux pour l'instant ; Entra ID viendra avec TLS) -----
    # Le formulaire admin natif reste actif (pas de disable_login_form) -> accès de secours.
    auth.generic_oauth:
      enabled: true
      name: Dex
      client_id: "{{ dex_grafana_client_id | default('grafana') }}"
      client_secret: "$__env{GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET}"
      scopes: "openid profile email groups"
      auth_url: "http://{{ dex_hostname }}/auth"
      token_url: "http://{{ dex_hostname }}/token"
      api_url: "http://{{ dex_hostname }}/userinfo"
      login_attribute_path: email
      email_attribute_path: email
      # Mapping de rôle par email (les comptes locaux Dex n'émettent pas de claim groups).
      role_attribute_path: "email == '{{ grafana_oauth_admin_email }}' && 'Admin' || 'Viewer'"
      allow_sign_up: true
      use_pkce: true
  service:
    type: ClusterIP
  nodeSelector:
    kubernetes.io/hostname: {{ monitoring_target_node_name }}
  persistence:
    enabled: true
    type: pvc
    storageClassName: {{ monitoring_storage_class }}
    accessModes: ["ReadWriteOnce"]
    size: 5Gi

# ----- Prometheus (interne uniquement — JAMAIS exposé publiquement, pas d'HTTPRoute) -----
# Grafana l'interroge via le service ClusterIP kube-prometheus-kube-prome-prometheus:9090.
# Accès humain : kubectl port-forward -n monitoring svc/kube-prometheus-kube-prome-prometheus 9090.
prometheus:
  service:
    type: ClusterIP
  prometheusSpec:
    retention: {{ monitoring_prometheus_retention }}
    routePrefix: /
    nodeSelector:
      kubernetes.io/hostname: {{ monitoring_target_node_name }}
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: {{ monitoring_storage_class }}
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: {{ monitoring_prometheus_pvc_size }}

# ----- Alertmanager -----
alertmanager:
  alertmanagerSpec:
    nodeSelector:
      kubernetes.io/hostname: {{ monitoring_target_node_name }}
    storage:
      volumeClaimTemplate:
        spec:
          storageClassName: {{ monitoring_storage_class }}
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 2Gi

# ----- prometheus-operator -----
prometheusOperator:
  nodeSelector:
    kubernetes.io/hostname: {{ monitoring_target_node_name }}
  admissionWebhooks:
    patch:
      nodeSelector:
        kubernetes.io/hostname: {{ monitoring_target_node_name }}

# ----- kube-state-metrics -----
kube-state-metrics:
  nodeSelector:
    kubernetes.io/hostname: {{ monitoring_target_node_name }}

# ----- node-exporter : un pod par nœud (DaemonSet) -----
prometheus-node-exporter:
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule
    - key: node-role.kubernetes.io/master
      operator: Exists
      effect: NoSchedule
